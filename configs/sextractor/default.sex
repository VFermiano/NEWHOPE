# Detection settings for astrometric source catalogs.
CATALOG_NAME                 sources.cat
CATALOG_TYPE                 FITS_LDAC
PARAMETERS_NAME              configs/sextractor/default.param
DETECT_TYPE                  CCD
DETECT_MINAREA               5
DETECT_THRESH                5.0
ANALYSIS_THRESH              5.0
FILTER                       Y
FILTER_NAME                  configs/sextractor/default.conv
DEBLEND_NTHRESH              32
DEBLEND_MINCONT               0.005
CLEAN                        Y
CLEAN_PARAM                   1.0
MASK_TYPE                    CORRECT
PHOT_APERTURES                5
PHOT_AUTOPARAMS               2.5,3.5
GAIN                          0.0
PIXEL_SCALE                   0.0
BACK_TYPE                     AUTO
BACK_SIZE                     64
BACK_FILTERSIZE               3
BACKPHOTO_TYPE                GLOBAL
BACKPHOTO_THICK               24
CHECKIMAGE_TYPE               NONE
CHECKIMAGE_NAME               check.fits
MEMORY_OBJSTACK               3000
MEMORY_PIXSTACK               300000
MEMORY_BUFSIZE                1024
VERBOSE_TYPE                  NORMAL
WRITE_XML                     N
XML_NAME                      sextractor.xml
